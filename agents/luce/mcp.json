{
  "mcpServers": {
    "github-write": {
      "command": "github-mcp-server",
      "args": [
        "stdio",
        "--features=pull_requests_granular",
        "--tools",
        "get_me,issue_read,search_issues,get_file_contents,add_issue_comment,list_pull_requests,create_pull_request,update_pull_request_draft_state,request_pull_request_reviewers,pull_request_read,create_pull_request_review,add_pull_request_review_comment,submit_pending_pull_request_review,add_reply_to_pull_request_comment"
      ],
      "lifecycle": "keep-alive",
      "requestTimeoutMs": 30000
    }
  }
}
