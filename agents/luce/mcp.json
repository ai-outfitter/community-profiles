{
  "mcpServers": {
    "github-hosted": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Tools": "get_me,issue_read,search_issues,get_file_contents,add_issue_comment,list_pull_requests,create_pull_request,pull_request_read,pull_request_review_write,add_comment_to_pending_review,add_reply_to_pull_request_comment"
      },
      "requestTimeoutMs": 30000
    }
  }
}
