{
  "mcpServers": {
    "github-hosted": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "all"
      },
      "requestTimeoutMs": 30000
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.55", "--isolated", "--browser", "chromium"]
    }
  }
}
